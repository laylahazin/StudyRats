<!-- Declara que o documento segue a versão HTML5 da linguagem. -->
<!DOCTYPE html>
<!-- O elemento html envolve toda a página; lang="en" declara idioma inglês. -->
<html lang="en">
  <!-- head contém metadados e informações não exibidas como conteúdo principal. -->
  <head>
    <!-- Define a codificação UTF-8 para exibir caracteres corretamente. -->
    <meta charset="utf-8">
    <!-- Define "StudyRats log" como título da aba ou janela do navegador. -->
    <title>StudyRats log</title>
  <!-- Fecha a seção de metadados iniciada por head. -->
  </head>
  <!-- body contém o conteúdo visual da página web. -->
  <body>
    <!-- h1 é o título principal visível; o texto identifica a página. -->
    <h1>StudyRats log</h1>
    <!-- p forma um parágrafo; o texto descreve o propósito do registro. -->
    <p>A log of the repositories I've starred.</p>
  <!-- Fecha o conteúdo visível iniciado por body. -->
  </body>
<!-- Fecha o elemento raiz html e, portanto, o documento. -->
</html>
